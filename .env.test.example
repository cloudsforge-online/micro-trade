# Read only by the test suite, and only when the database name contains "test" —
# the database-backed tests truncate every table this service owns.
#
# See the note in src/testsupport.ts for why this is TRADE_TEST_DSN rather than the
# TRADE_TEST_DATABASE_URL every sibling uses: the org's reusable service-ci.yml enforces
# "one database variable" by grepping src/ and has no exemption for a test-only DSN.
export TRADE_TEST_DSN='postgres://cloudsforge:CHANGE_ME@127.0.0.1:5432/trade_test'
